{
  "name": "Payment Failed Notification",
  "description": "Sends email notification when a payment fails",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"failed\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "PaymentEvent"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "payment_failed_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendNotification",
            "args": {
              "type": "payment_failed"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendNotification"
  }
}