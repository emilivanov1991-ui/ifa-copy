    "metlife_ul_life_coverage_default": {
      "type": "number",
      "description": "\u041f\u043e\u043a\u0440\u0438\u0442\u0438\u0435 \u0436\u0438\u0432\u043e\u0442 \u043f\u043e \u043f\u043e\u0434\u0440\u0430\u0437\u0431\u0438\u0440\u0430\u043d\u0435 \u0431\u0435\u0437 \u043f\u0430\u0440\u0442\u043d\u044c\u043e\u0440/\u0434\u0435\u0446\u0430 (EUR)",
      "default": 2500
    },
    "insurance_coverages": {
      "type": "object",
      "description": "\u041f\u0440\u0435\u043f\u043e\u0440\u044a\u0447\u0438\u0442\u0435\u043b\u043d\u0438 \u0437\u0430\u0441\u0442\u0440\u0430\u0445\u043e\u0432\u0430\u0442\u0435\u043b\u043d\u0438 \u043f\u043e\u043a\u0440\u0438\u0442\u0438\u044f",
      "properties": {
        "disability": {
          "type": "object",
          "properties": {
            "formula": {
              "type": "string",
              "default": "80% * (\u043f\u0440\u043e\u043c\u0435\u043d\u043b\u0438\u0432\u0438_\u0440\u0430\u0437\u0445\u043e\u0434\u0438 - \u0441\u043e\u0446\u0438\u0430\u043b\u043d\u0430_\u0438\u0437\u0434\u0440\u044a\u0436\u043a\u0430) * (80 - \u0432\u044a\u0437\u0440\u0430\u0441\u0442) * 12"
            },
            "source_field_expenses": {
              "type": "string",
              "default": "analysis.protection.income_protection.disability.variable_expenses"
            },
            "source_field_social_support": {
              "type": "string",
              "default": "analysis.protection.income_protection.disability.social_support"
            }
          }
        },
        "fractures_burns": {
          "type": "number",
          "description": "\u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0430 \u0441\u0443\u043c\u0430 \u0437\u0430 \u0444\u0440\u0430\u043a\u0442\u0443\u0440\u0438 \u0438 \u0438\u0437\u0433\u0430\u0440\u044f\u043d\u0438\u044f (EUR)",
          "default": 1500
        },
        "critical_illness": {
          "type": "object",
          "properties": {
            "formula": {
              "type": "string",
              "default": "(\u043f\u0440\u043e\u043c\u0435\u043d\u043b\u0438\u0432\u0438_\u0440\u0430\u0437\u0445\u043e\u0434\u0438 - \u0441\u043e\u0446\u0438\u0430\u043b\u043d\u0430_\u0438\u0437\u0434\u0440\u044a\u0436\u043a\u0430) * 3 * 12"
            },
            "ul_coverage_count": {
              "type": "number",
              "default": 40
            },
            "term_life_coverage_count": {
              "type": "number",
              "default": 32
            }
          }
        },
        "recommended_coverages": {
