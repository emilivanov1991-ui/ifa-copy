{
  "name": "ExamQuestion",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "option_a": {
      "type": "string"
    },
    "option_b": {
      "type": "string"
    },
    "option_c": {
      "type": "string"
    },
    "option_d": {
      "type": "string"
    },
    "correct_answer": {
      "type": "string",
      "enum": [
        "a",
        "b",
        "c",
        "d"
      ]
    },
    "explanation": {
      "type": "string",
      "description": "\u041e\u0431\u044f\u0441\u043d\u0435\u043d\u0438\u0435 \u0441\u043b\u0435\u0434 \u043e\u0442\u0433\u043e\u0432\u043e\u0440"
    },
    "order": {
      "type": "number",
      "default": 100
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "course_id",
    "question",
    "option_a",
    "option_b",
    "correct_answer"
  ]
}