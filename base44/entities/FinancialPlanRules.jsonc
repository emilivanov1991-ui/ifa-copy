{
  "name": "FinancialPlanRules",
  "type": "object",
  "properties": {
    "rule_version": {
      "type": "string",
      "description": "\u0412\u0435\u0440\u0441\u0438\u044f \u043d\u0430 \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u0442\u0430",
      "default": "1.0"
    },
    "is_active": {
      "type": "boolean",
      "description": "\u0410\u043a\u0442\u0438\u0432\u043d\u0430 \u043b\u0438 \u0435 \u0442\u0430\u0437\u0438 \u0432\u0435\u0440\u0441\u0438\u044f \u043d\u0430 \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u0442\u0430",
      "default": true
    },
    "optimization_rules": {
      "type": "object",
      "description": "\u041f\u0440\u0430\u0432\u0438\u043b\u0430 \u0437\u0430 \u043e\u043f\u0442\u0438\u043c\u0438\u0437\u0430\u0446\u0438\u044f \u043d\u0430 \u0441\u044a\u0449\u0435\u0441\u0442\u0432\u0443\u0432\u0430\u0449\u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438",
      "properties": {
        "mortgage": {
          "type": "object",
          "properties": {
            "refinance_condition": {
              "type": "string",
              "default": "\u041d\u043e\u0432\u0430 \u043c\u0435\u0441\u0435\u0447\u043d\u0430 \u0432\u043d\u043e\u0441\u043a\u0430 \u043f\u043e-\u043d\u0438\u0441\u043a\u0430 \u0418 \u0441\u043f\u0435\u0441\u0442\u0435\u043d\u043e\u0442\u043e \u043f\u043e\u043a\u0440\u0438\u0432\u0430 \u0442\u0430\u043a\u0441\u0438\u0442\u0435 \u0437\u0430 2 \u0433\u043e\u0434\u0438\u043d\u0438"
            },
            "refinance_fees_formula": {
              "type": "string",
              "default": "0.2% \u043e\u0442 \u043e\u0441\u0442\u0430\u0442\u044a\u043a\u0430 + 20% \u043e\u0442 \u0442\u0430\u0437\u0438 \u0441\u0443\u043c\u0430 + 60 \u043b\u0432. + 70 \u043b\u0432."
            },
            "max_term_years": {
              "type": "number",
              "default": 30
            },
            "max_age": {
              "type": "number",
              "default": 70
            },
            "recommend_different_bank": {
              "type": "boolean",
              "default": true
            },
            "recommend_metlife_credit_guard": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "consumer_loan": {
          "type": "object",
          "properties": {
            "max_term_years": {
              "type": "number",
              "default": 10
            },
            "max_age": {
              "type": "number",
              "default": 70
            },
            "recommend_different_bank": {
              "type": "boolean",
              "default": true
            },
            "recommend_metlife_credit_guard": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "insurance_home": {
          "type": "object",
          "properties": {
            "primary_provider": {
              "type": "string",
              "default": "\u0418\u043d\u0441\u0442\u0438\u043d\u043a\u0442"
            },
            "primary_provider_limit": {
              "type": "number",
              "default": 500000
            },
            "secondary_provider": {
              "type": "string",
              "default": "\u0414\u0417\u0418 \u0417\u0430\u0449\u0438\u0442\u0430 \u0437\u0430 \u0434\u043e\u043c\u0430"
            },
            "recommend_different_provider": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "insurance_casco_go": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "default": "\u0414\u0417\u0418"
            },
            "recommend_different_provider": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "pension_fund": {
          "type": "object",
          "properties": {
            "target_provider": {
              "type": "string",
              "default": "\u041e\u0411\u0411 \u041f\u0435\u043d\u0441\u0438\u043e\u043d\u043d\u043e"
            },
            "always_optimize": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "investments": {
          "type": "object",
          "properties": {
            "optimize": {
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    },
    "plan_limits": {
      "type": "object",
      "description": "\u041b\u0438\u043c\u0438\u0442\u0438 \u043d\u0430 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u0438\u044f \u043f\u043b\u0430\u043d",
      "properties": {
        "max_annual_plan_vs_income": {
          "type": "number",
          "description": "\u041c\u0430\u043a\u0441 % \u043e\u0442 \u0433\u043e\u0434\u0438\u0448\u0435\u043d \u0434\u043e\u0445\u043e\u0434 (1.5 = 150%)",
          "default": 1.5
        },
        "max_monthly_plan_vs_balance": {
          "type": "number",
          "description": "\u041c\u0430\u043a\u0441 % \u043e\u0442 \u043c\u0435\u0441\u0435\u0447\u0435\u043d \u0431\u0430\u043b\u0430\u043d\u0441 (0.4 = 40%)",
          "default": 0.4
        },
        "max_insurance_vs_plan": {
          "type": "number",
          "description": "\u041c\u0430\u043a\u0441 % \u0437\u0430\u0441\u0442\u0440\u0430\u0445\u043e\u0432\u043a\u0438 \u0436\u0438\u0432\u043e\u0442 \u043e\u0442 \u043f\u043b\u0430\u043d (0.33 = 33%)",
          "default": 0.33
        },
        "max_insurance_vs_net_income": {
          "type": "number",
          "description": "\u041c\u0430\u043a\u0441 % \u0437\u0430\u0441\u0442\u0440\u0430\u0445\u043e\u0432\u043a\u0438 \u0436\u0438\u0432\u043e\u0442 \u043e\u0442 \u043d\u0435\u0442\u0435\u043d \u0434\u043e\u0445\u043e\u0434 (0.04 = 4%)",
          "default": 0.04
        },
        "min_investments_vs_plan": {
          "type": "number",
          "description": "\u041c\u0438\u043d % \u0438\u043d\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0438 \u043e\u0442 \u043f\u043b\u0430\u043d (0.45 = 45%)",
          "default": 0.45
        },
        "min_monthly_investment": {
          "type": "number",
          "description": "\u041c\u0438\u043d\u0438\u043c\u0430\u043b\u043d\u0430 \u043c\u0435\u0441\u0435\u0447\u043d\u0430 \u0438\u043d\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u044f \u0432 \u043b\u0435\u0432\u0430",
          "default": 50
        }
      }
    },
    "mortgage_new_property_rules": {
      "type": "object",
      "description": "\u041f\u0440\u0430\u0432\u0438\u043b\u0430 \u0437\u0430 \u043d\u043e\u0432 \u0438\u043f\u043e\u0442\u0435\u0447\u0435\u043d \u043a\u0440\u0435\u0434\u0438\u0442 \u043f\u0440\u0438 \u043f\u043e\u043a\u0443\u043f\u043a\u0430 \u043d\u0430 \u0436\u0438\u043b\u0438\u0449\u0435",
      "properties": {
        "max_payment_vs_balance": {
          "type": "number",
          "description": "\u041c\u0430\u043a\u0441 \u0432\u043d\u043e\u0441\u043a\u0430 \u043e\u0442 \u043c\u0435\u0441\u0435\u0447\u0435\u043d \u0431\u0430\u043b\u0430\u043d\u0441 \u043f\u0440\u0435\u0434\u0438 \u043d\u0430\u043c\u0430\u043b\u0435\u043d\u0438\u0435 (0.9 = 90%)",
          "default": 0.9
        },
        "max_payment_vs_net_income": {
          "type": "number",
          "description": "\u041c\u0430\u043a\u0441 \u0432\u043d\u043e\u0441\u043a\u0430 \u043e\u0442 \u043d\u0435\u0442\u0435\u043d \u0434\u043e\u0445\u043e\u0434 (\u043b\u0438\u043c\u0438\u0442 \u0411\u041d\u0411) (0.5 = 50%)",
          "default": 0.5
        },
        "reduced_payment_vs_balance": {
          "type": "number",
          "description": "\u041d\u0430\u043c\u0430\u043b\u0435\u043d\u0430 \u0432\u043d\u043e\u0441\u043a\u0430 \u043f\u0440\u0438 \u043d\u0430\u0434\u0432\u0438\u0448\u0430\u0432\u0430\u043d\u0435 (0.86 = 86%)",
          "default": 0.86
        },
        "insurance_allocation": {
          "type": "number",
          "description": "\u0410\u043b\u043e\u043a\u0430\u0446\u0438\u044f \u0437\u0430 \u0437\u0430\u0441\u0442\u0440\u0430\u0445\u043e\u0432\u0430\u043d\u0435 \u043f\u0440\u0438 \u043d\u0430\u043c\u0430\u043b\u0435\u043d\u0438\u0435 (0.04 = 4%)",
          "default": 0.04
        }
      }
    },
    "standard_plan_structure": {
      "type": "object",
      "description": "\u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u043d\u0430 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0438\u044f \u043f\u043b\u0430\u043d",
      "properties": {
        "primary_product": {
          "type": "string",
          "default": "MetLife Unit Linked"
        },
        "pension_change": {
          "type": "string",
          "default": "\u041e\u0411\u0411 \u0423\u041f\u0424"
        },
        "pension_monthly_cost": {
          "type": "number",
          "description": "\u041c\u0435\u0441\u0435\u0447\u043d\u0430 \u0446\u0435\u043d\u0430 \u043d\u0430 \u0423\u041f\u0424 (\u0440\u0430\u0431\u043e\u0442\u0438\u043c \u0441 \u043d\u0435\u0442\u043d\u0438 \u0434\u043e\u0445\u043e\u0434\u0438)",
          "default": 0
        },
        "fallback_if_insufficient": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "MetLife \u0421\u0440\u043e\u0447\u0435\u043d \u0436\u0438\u0432\u043e\u0442 \u0438\u043b\u0438 \u0414\u0417\u0418 \u0417\u0430\u043a\u0440\u0438\u043b\u0430",
            "\u0414\u0417\u0418 \u0417\u0430\u043a\u0440\u0438\u043b\u0430 Gold 15 \u043b\u0432/\u043c\u0435\u0441\u0435\u0447\u043d\u043e"
          ]
        },
        "additions_if_extra_budget": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "priority": {
                "type": "number"
              },
              "product": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              }
            }
          },
          "default": [
            {
              "priority": 1,
              "product": "Uniqa \u0417\u0434\u0440\u0430\u0432\u0435 \u0438 \u0446\u0435\u043d\u043d\u043e\u0441\u0442 - \u041f\u043b\u0430\u043d \u0415\u0432\u0440\u043e\u043f\u0430",
              "condition": "\u0432\u0438\u043d\u0430\u0433\u0438"
            },
            {
              "priority": 2,
              "product": "Generali \u0431\u0430\u0437\u043e\u0432 \u043f\u0430\u043a\u0435\u0442",
              "condition": "\u0430\u043a\u043e \u043d\u044f\u043c\u0430 \u043e\u0442 \u0444\u0438\u0440\u043c\u0430"
            },
            {
              "priority": 3,
              "product": "\u0414\u0435\u0442\u0441\u043a\u0438 Unit Linked",
              "condition": "\u0430\u043a\u043e \u0438\u043c\u0430 \u0434\u0435\u0446\u0430"
            },
            {
              "priority": 4,
              "product": "\u041d\u043e\u0432 \u0438\u043f\u043e\u0442\u0435\u0447\u0435\u043d/\u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0441\u043a\u0438 \u043a\u0440\u0435\u0434\u0438\u0442",
              "condition": "\u0430\u043a\u043e \u0449\u0435 \u0437\u0430\u043a\u0443\u043f\u0443\u0432\u0430 \u0436\u0438\u043b\u0438\u0449\u0435"
            },
            {
              "priority": 5,
              "product": "\u0417\u0430\u0441\u0442\u0440\u0430\u0445\u043e\u0432\u043a\u0430 \u0437\u0430 \u0434\u043e\u043c\u0430",
              "condition": "\u0430\u043a\u043e \u0438\u043c\u0430 \u0436\u0438\u043b\u0438\u0449\u0435 \u0431\u0435\u0437 \u0437\u0430\u0441\u0442\u0440\u0430\u0445\u043e\u0432\u043a\u0430"
            },
            {
              "priority": 6,
              "product": "\u041a\u0430\u0441\u043a\u043e/\u0413\u041e",
              "condition": "\u0430\u043a\u043e \u0438\u043c\u0430 \u043a\u043e\u043b\u0430 \u043d\u0430\u0434 8000 \u043b\u0432 \u0431\u0435\u0437 \u041a\u0430\u0441\u043a\u043e"
            }
          ]
        }
      }
    },
    "metlife_ul_premium_bonus": {
      "type": "array",
      "description": "\u041f\u0440\u0435\u043c\u0438\u0435\u043d \u0431\u043e\u043d\u0443\u0441 MetLife UL \u043f\u043e \u0433\u043e\u0434\u0438\u0448\u043d\u0430 \u0441\u0443\u043c\u0430 (EUR)",
