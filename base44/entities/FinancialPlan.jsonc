{
  "name": "FinancialPlan",
  "type": "object",
  "properties": {
    "analysis_id": {
      "type": "string",
      "description": "Reference to FinancialAnalysisSubmission"
    },
    "client_id": {
      "type": "string",
      "description": "Reference to Client entity"
    },
    "journey_id": {
      "type": "string",
      "description": "Reference to Journey"
    },
    "verified_profile_id": {
      "type": "string",
      "description": "Reference to VerifiedClientProfile \u2014 snapshot \u043f\u0440\u0438 \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u0430\u043d\u0435"
    },
    "rulebook_version": {
      "type": "string",
      "description": "\u0412\u0435\u0440\u0441\u0438\u044f \u043d\u0430 \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u0442\u0430 \u043f\u0440\u0438 \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u0430\u043d\u0435",
      "default": "3.0"
    },
    "ruleset_hash": {
      "type": "string",
      "description": "SHA256 fingerprint \u043d\u0430 rulebook + \u0432\u0445\u043e\u0434\u043d\u0438 \u0434\u0430\u043d\u043d\u0438 \u2014 \u0437\u0430 compliance audit"
    },
    "plan_status": {
      "type": "string",
      "enum": [
        "draft",
        "calculated",
        "approved",
        "sent_to_client"
      ],
      "default": "draft"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "partner1_age": {
      "type": "number"
    },
    "partner2_age": {
      "type": "number"
    },
    "years_to_retirement_p1": {
      "type": "number"
    },
    "years_to_retirement_p2": {
      "type": "number"
    },
    "total_monthly_income": {
      "type": "number"
    },
    "total_monthly_expenses": {
      "type": "number"
    },
    "available_for_investment": {
      "type": "number"
    },
    "protection_need_p1": {
      "type": "number",
      "description": "\u041d\u0443\u0436\u0434\u0430 \u043e\u0442 \u0437\u0430\u0449\u0438\u0442\u0430 \u0437\u0430 \u043f\u0430\u0440\u0442\u043d\u044c\u043e\u0440 1"
    },
    "protection_need_p2": {
      "type": "number",
      "description": "\u041d\u0443\u0436\u0434\u0430 \u043e\u0442 \u0437\u0430\u0449\u0438\u0442\u0430 \u0437\u0430 \u043f\u0430\u0440\u0442\u043d\u044c\u043e\u0440 2"
    },
    "reserve_need": {
      "type": "number",
      "description": "\u041d\u0443\u0436\u0434\u0430 \u043e\u0442 \u0440\u0435\u0437\u0435\u0440\u0432 (\u043c\u0435\u0441\u0435\u0447\u043d\u0438 \u0440\u0430\u0437\u0445\u043e\u0434\u0438 x \u0436\u0435\u043b\u0430\u043d\u0438 \u043c\u0435\u0441\u0435\u0446\u0438)"
    },
    "pension_gap_p1": {
      "type": "number",
      "description": "\u041f\u0435\u043d\u0441\u0438\u043e\u043d\u0435\u043d \u0434\u0435\u0444\u0438\u0446\u0438\u0442 \u0437\u0430 \u043f\u0430\u0440\u0442\u043d\u044c\u043e\u0440 1"
    },
    "pension_gap_p2": {
      "type": "number",
      "description": "\u041f\u0435\u043d\u0441\u0438\u043e\u043d\u0435\u043d \u0434\u0435\u0444\u0438\u0446\u0438\u0442 \u0437\u0430 \u043f\u0430\u0440\u0442\u043d\u044c\u043e\u0440 2"
    },
    "education_need_child1": {
      "type": "number"
    },
    "education_need_child2": {
      "type": "number"
    },
    "education_need_child3": {
      "type": "number"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_type": {
            "type": "string",
            "enum": [
              "term_life",
              "ul_investment",
              "education_plan",
              "health_insurance",
              "critical_illness",
              "pension_plan",
              "personal_accident"
            ]
          },
          "provider": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "beneficiary": {
            "type": "string",
            "enum": [
              "partner1",
              "partner2",
              "child1",
              "child2",
              "child3",
              "child4",
              "child5",
              "family"
            ]
          },
          "beneficiary_name": {
            "type": "string"
          },
          "beneficiary_age": {
            "type": "number"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "conservative",
              "balanced",
              "dynamic",
              "aggressive"
            ]
          },
          "term_years": {
            "type": "number"
          },
          "monthly_premium": {
            "type": "number"
          },
          "total_premium": {
            "type": "number"
          },
          "coverage_amount": {
            "type": "number"
          },
          "expected_value": {
            "type": "number"
          },
          "is_active": {
            "type": "boolean",
            "default": true
          },
          "details": {
            "type": "object"
          }
        }
      }
    },
    "total_monthly_premium": {
      "type": "number"
    },
    "total_coverage": {
      "type": "number"
    },
    "total_expected_value": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "analysis_id"
  ]
}