{
  "name": "Journey Signing \u2192 Evrotrust Trigger",
  "description": "Triggers Evrotrust signing session when Journey enters signing_in_progress state",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"journey_state\") != null) and (.trigger.data.journey_state == \"signing_in_progress\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Journey"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "journey_signing_evrotrust_trigger",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "createEvrotrustSigningSession",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "createEvrotrustSigningSession"
  }
}