  "whatsapp_greeting": "\u0417\u0434\u0440\u0430\u0432\u0435\u0439\u0442\u0435! \u0410\u0437 \u0441\u044a\u043c AI \u0430\u043d\u0430\u043b\u0438\u0437\u0430\u0442\u043e\u0440\u044a\u0442 \u043d\u0430 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u0438 \u043f\u043b\u0430\u043d\u043e\u0432\u0435. \u041c\u043e\u0433\u0430 \u0434\u0430 \u0432\u0438 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438, \u0430\u043d\u0430\u043b\u0438\u0437\u0438 \u043d\u0430 \u0443\u0441\u043f\u0435\u0432\u0430\u0435\u043c\u043e\u0441\u0442 \u0438 \u043f\u0440\u0435\u043f\u043e\u0440\u044a\u043a\u0438 \u0437\u0430 \u043f\u043e\u0434\u043e\u0431\u0440\u0435\u043d\u0438\u0435 \u043d\u0430 \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u0442\u0430 \u0437\u0430 \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u043f\u043b\u0430\u043d\u043e\u0432\u0435. \u041a\u0430\u043a \u043c\u043e\u0433\u0430 \u0434\u0430 \u0432\u0438 \u043f\u043e\u043c\u043e\u0433\u043d\u0430?",
  "name": "financial_plan_analyzer"
}