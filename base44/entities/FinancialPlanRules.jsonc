    "metlife_ul_life_coverage_multipliers": {
      "type": "array",
      "description": "\u041c\u0443\u043b\u0442\u0438\u043f\u043b\u0438\u043a\u0430\u0442\u043e\u0440\u0438 \u0437\u0430 \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u0430\u043d\u043e \u043f\u043e\u043a\u0440\u0438\u0442\u0438\u0435 \u0436\u0438\u0432\u043e\u0442 \u043f\u043e \u0432\u044a\u0437\u0440\u0430\u0441\u0442",
      "items": {
        "type": "object",
        "properties": {
          "age_from": {
            "type": "number"
          },
