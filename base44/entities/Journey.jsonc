{
  "name": "Journey",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Reference to Client entity"
    },
    "user_id": {
      "type": "string",
      "description": "Base44 authenticated user ID \u2014 \u043e\u0441\u043d\u043e\u0432\u043d\u0430 \u0432\u0440\u044a\u0437\u043a\u0430 \u0441 \u043f\u0440\u043e\u0444\u0438\u043b\u0430"
    },
    "device_id": {
      "type": "string",
      "description": "Browser device fingerprint stored in localStorage"
    },
    "language_code": {
      "type": "string",
      "enum": [
        "bg",
        "en"
      ],
      "default": "bg"
    },
    "journey_state": {
      "type": "string",
      "enum": [
        "discovery_not_started",
        "discovery_intro_in_progress",
        "discovery_collecting",
        "discovery_resumed_pending_reverification",
        "discovery_ready_for_review",
        "discovery_blocked",
        "analysis_approved",
        "plan_generating",
        "plan_ready",
        "plan_auto_sell_blocked",
        "presentation_intro_pending",
        "presentation_in_progress",
        "presentation_stopped_boundary",
        "application_collecting",
        "application_incomplete",
        "application_ready_for_signing",
        "signing_in_progress",
        "signing_failed",
        "payment_in_progress",
        "payment_failed",
        "provider_submission_in_progress",
        "completed",
        "graceful_stop"
      ],
      "default": "discovery_not_started",
      "description": "\u0422\u0435\u043a\u0443\u0449\u043e\u0442\u043e \u0441\u044a\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043d\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u044f \u0432 \u043f\u0440\u043e\u0446\u0435\u0441\u0430. \u0411\u0435\u0437 \u043a\u0440\u0430\u0435\u043d \u0441\u0440\u043e\u043a \u2014 \u043f\u0430\u0437\u0438 \u0441\u0435 \u0431\u0435\u0437\u0441\u0440\u043e\u0447\u043d\u043e."
    },
    "previous_state": {
      "type": "string",
      "description": "\u041f\u043e\u0441\u043b\u0435\u0434\u043d\u043e\u0442\u043e \u0441\u044a\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043f\u0440\u0435\u0434\u0438 \u0442\u0435\u043a\u0443\u0449\u043e\u0442\u043e \u2014 \u0437\u0430 rollback \u043f\u0440\u0438 \u0433\u0440\u0435\u0448\u043a\u0430"
    },
    "last_section_id": {
      "type": "string",
      "description": "ID \u043d\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0430\u0442\u0430 \u0441\u0435\u043a\u0446\u0438\u044f/\u0441\u0442\u044a\u043f\u043a\u0430 \u2014 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430 \u0441\u0435 \u0437\u0430 \u0434\u0438\u0440\u0435\u043a\u0442\u0435\u043d resume \u0431\u0435\u0437 \u043d\u043e\u0432\u043e \u043f\u043e\u043f\u044a\u043b\u0432\u0430\u043d\u0435"
    },
    "state_changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "discovery_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "discovery_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "presentation_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u041e\u0431\u043d\u043e\u0432\u044f\u0432\u0430 \u0441\u0435 \u043f\u0440\u0438 \u0432\u0441\u044f\u043a\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u2014 \u0431\u0435\u0437 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435 \u0437\u0430 \u0438\u0437\u0442\u0438\u0447\u0430\u043d\u0435"
    },
    "form_data_version": {
      "type": "string",
      "description": "\u0412\u0435\u0440\u0441\u0438\u044f \u043d\u0430 \u0441\u0445\u0435\u043c\u0430\u0442\u0430 \u043d\u0430 \u0444\u043e\u0440\u043c\u0430\u0442\u0430 \u043f\u0440\u0438 \u043f\u043e\u043f\u044a\u043b\u0432\u0430\u043d\u0435 \u2014 \u0437\u0430 \u043e\u0431\u0440\u0430\u0442\u043d\u0430 \u0441\u044a\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u043e\u0441\u0442 \u043f\u0440\u0438 \u0431\u044a\u0434\u0435\u0449\u0438 \u043f\u0440\u043e\u043c\u0435\u043d\u0438"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Soft-delete \u043f\u0440\u0438 \u0441\u0442\u0430\u0440\u0442\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u0438\u0437\u0446\u044f\u043b\u043e \u043d\u043e\u0432 \u043f\u0440\u043e\u0446\u0435\u0441. \u0421\u0442\u0430\u0440\u0438\u0442\u0435 \u0434\u0430\u043d\u043d\u0438 \u0441\u0435 \u0437\u0430\u043f\u0430\u0437\u0432\u0430\u0442 \u0437\u0430 \u043e\u0434\u0438\u0442. \u041d\u042f\u041c\u0410 \u0438\u0437\u0442\u0438\u0447\u0430\u0449 \u0441\u0440\u043e\u043a \u2014 Journey \u0435 \u043f\u0435\u0440\u043c\u0430\u043d\u0435\u043d\u0442\u0435\u043d \u043a\u044a\u043c user_id."
    },
    "reverification_pending": {
      "type": "boolean",
      "default": false,
      "description": "true = \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u044f\u0442 \u043d\u0430\u0442\u0438\u0441\u043d\u0430 '\u041d\u0435' \u043f\u0440\u0438 reverification \u2014 \u0447\u0430\u043a\u0430 \u043f\u043e\u0442\u0432\u044a\u0440\u0436\u0434\u0435\u043d\u0438\u0435 \u043d\u0430 \u0441\u0435\u043a\u0446\u0438\u0438\u0442\u0435"
    },
    "reverification_flags": {
      "type": "object",
      "description": "\u0421\u0435\u043a\u0446\u0438\u0438, \u043e\u0442\u0431\u0435\u043b\u044f\u0437\u0430\u043d\u0438 \u043a\u0430\u0442\u043e \u043d\u0435\u0430\u043a\u0442\u0443\u0430\u043b\u043d\u0438 \u043e\u0442 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u044f. Key = section_id, Value = false (\u043d\u0435\u0430\u043a\u0442\u0443\u0430\u043b\u043d\u0430) / true (\u043f\u043e\u0442\u0432\u044a\u0440\u0434\u0435\u043d\u0430)",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "reverification_completed": {
      "type": "boolean",
      "default": false,
      "description": "true = \u0432\u0441\u0438\u0447\u043a\u0438 \u043d\u0435\u0430\u043a\u0442\u0443\u0430\u043b\u043d\u0438 \u0441\u0435\u043a\u0446\u0438\u0438 \u0441\u0430 \u043a\u043e\u0440\u0438\u0433\u0438\u0440\u0430\u043d\u0438 \u0438 \u043f\u043e\u0442\u0432\u044a\u0440\u0434\u0435\u043d\u0438"
    },
    "analysis_id": {
      "type": "string",
      "description": "Reference to FinancialAnalysisSubmission"
    },
    "verified_profile_id": {
      "type": "string",
      "description": "Reference to VerifiedClientProfile \u2014 \u0441\u044a\u0437\u0434\u0430\u0432\u0430 \u0441\u0435 \u043f\u0440\u0438 analysis_approved"
    },
    "plan_id": {
      "type": "string",
      "description": "Reference to FinancialPlan"
    },
    "compliance_audit_id": {
      "type": "string",
      "description": "Reference to ComplianceAuditRecord"
    },
    "rulebook_version": {
      "type": "string",
      "description": "\u0412\u0435\u0440\u0441\u0438\u044f \u043d\u0430 \u0431\u0438\u0437\u043d\u0435\u0441 \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u0442\u0430 \u043f\u0440\u0438 \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u043f\u043b\u0430\u043d\u0430 \u2014 \u0437\u0430 compliance \u043e\u0434\u0438\u0442"
    },
    "ruleset_hash": {
      "type": "string",
      "description": "SHA256 hash \u043d\u0430 rulebook \u2014 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0441\u0442\u0432\u043e \u0437\u0430 \u043d\u0435\u043f\u0440\u043e\u043c\u0435\u043d\u0435\u043d\u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u043f\u0440\u0438 \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u0430\u043d\u0435\u0442\u043e"
    },
    "auto_sell_eligible": {
      "type": "boolean",
      "default": false
    },
    "manual_review_required": {
      "type": "boolean",
      "default": false
    },
    "graceful_stop_reason": {
      "type": "string",
      "description": "\u041f\u0440\u0438\u0447\u0438\u043d\u0430 \u0437\u0430 \u0440\u044a\u0447\u043d\u043e \u0441\u043f\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f\u0442\u0430"
    },
    "follow_up_task_id": {
      "type": "string",
      "description": "Reference to FollowUpTask \u043f\u0440\u0438 graceful stop"
    },
    "retell_call_id": {
      "type": "string",
      "description": "ID \u043d\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0430\u0442\u0430 \u0430\u043a\u0442\u0438\u0432\u043d\u0430 Retell \u0433\u043b\u0430\u0441\u043e\u0432\u0430 \u0441\u0435\u0441\u0438\u044f"
    },
    "presentation_section_index": {
      "type": "number",
      "default": 0,
      "description": "\u0422\u0435\u043a\u0443\u0449\u0430\u0442\u0430 \u0441\u0435\u043a\u0446\u0438\u044f \u0432 \u043f\u0440\u0435\u0437\u0435\u043d\u0442\u0430\u0446\u0438\u044f\u0442\u0430 \u043d\u0430 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u0438\u044f \u043f\u043b\u0430\u043d"
    },
    "discovery_progress_percent": {
      "type": "number",
      "default": 0,
      "description": "\u0418\u0437\u0447\u0438\u0441\u043b\u0435\u043d % \u043f\u0440\u043e\u0433\u0440\u0435\u0441 \u043d\u0430 discovery (0-100)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": []
}