{
  "name": "QuestionPromptLibrary",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string",
      "description": "\u0423\u043d\u0438\u043a\u0430\u043b\u0435\u043d \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440 \u043d\u0430\u043f\u0440. 'q_housing_type', 'q_monthly_income'"
    },
    "section_id": {
      "type": "string",
      "description": "\u0421\u0435\u043a\u0446\u0438\u044f\u0442\u0430 \u043a\u044a\u043c \u043a\u043e\u044f\u0442\u043e \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438 \u0432\u044a\u043f\u0440\u043e\u0441\u044a\u0442 \u043d\u0430\u043f\u0440. 'housing', 'income', 'protection'"
    },
    "section_order": {
      "type": "number",
      "description": "\u0420\u0435\u0434 \u043d\u0430 \u0441\u0435\u043a\u0446\u0438\u044f\u0442\u0430 \u0432 \u043e\u0431\u0449\u0438\u044f flow"
    },
    "question_order": {
      "type": "number",
      "description": "\u0420\u0435\u0434 \u043d\u0430 \u0432\u044a\u043f\u0440\u043e\u0441\u0430 \u0432\u044a\u0442\u0440\u0435 \u0432 \u0441\u0435\u043a\u0446\u0438\u044f\u0442\u0430"
    },
    "language_code": {
      "type": "string",
      "enum": [
        "bg",
        "en"
      ],
      "default": "bg"
    },
    "field_name": {
      "type": "string",
      "description": "\u041f\u043e\u043b\u0435\u0442\u043e \u0432 FinancialAnalysisSubmission \u043a\u043e\u0435\u0442\u043e \u0441\u0435 \u043f\u043e\u043f\u044a\u043b\u0432\u0430 \u043d\u0430\u043f\u0440. 'current_housing'"
    },
    "label": {
      "type": "string",
      "description": "\u0422\u0435\u043a\u0441\u0442 \u043d\u0430 \u0432\u044a\u043f\u0440\u043e\u0441\u0430 \u0437\u0430 UI"
    },
    "sub_label": {
      "type": "string",
      "description": "\u0414\u043e\u043f\u044a\u043b\u043d\u0438\u0442\u0435\u043b\u0435\u043d \u043f\u043e\u044f\u0441\u043d\u0438\u0442\u0435\u043b\u0435\u043d \u0442\u0435\u043a\u0441\u0442 \u043f\u043e\u0434 \u0432\u044a\u043f\u0440\u043e\u0441\u0430"
    },
    "input_type": {
      "type": "string",
      "enum": [
        "text",
        "number",
        "boolean",
        "select",
        "multi_select",
        "date",
        "currency",
        "slider",
        "radio"
      ],
      "description": "\u0422\u0438\u043f \u043d\u0430 UI \u043f\u043e\u043b\u0435\u0442\u043e"
    },
    "options": {
      "type": "array",
      "description": "\u0417\u0430 select/radio/multi_select \u2014 \u0441\u043f\u0438\u0441\u044a\u043a \u0441 \u043e\u043f\u0446\u0438\u0438",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "validation_rules": {
      "type": "object",
      "description": "\u041f\u0440\u0430\u0432\u0438\u043b\u0430 \u0437\u0430 \u0432\u0430\u043b\u0438\u0434\u0430\u0446\u0438\u044f",
      "properties": {
        "required": {
          "type": "boolean",
          "default": false
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "min_length": {
          "type": "number"
        },
        "max_length": {
          "type": "number"
        },
        "pattern": {
          "type": "string"
        }
      }
    },
    "show_if": {
      "type": "string",
      "description": "expr-eval \u0438\u0437\u0440\u0430\u0437 \u0437\u0430 \u0443\u0441\u043b\u043e\u0432\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430\u043f\u0440. 'include_partner == true'"
    },
    "skip_if": {
      "type": "string",
      "description": "expr-eval \u0438\u0437\u0440\u0430\u0437 \u2014 \u0430\u043a\u043e \u0435 true, \u0432\u044a\u043f\u0440\u043e\u0441\u044a\u0442 \u0441\u0435 \u043f\u0440\u0435\u0441\u043a\u0430\u0447\u0430 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e"
    },
    "contradiction_rules": {
      "type": "array",
      "description": "\u041f\u0440\u0430\u0432\u0438\u043b\u0430 \u0437\u0430 \u0437\u0430\u0441\u0438\u0447\u0430\u043d\u0435 \u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u044f \u0441 \u0432\u0435\u0447\u0435 \u0434\u0430\u0434\u0435\u043d\u0438 \u043e\u0442\u0433\u043e\u0432\u043e\u0440\u0438",
      "items": {
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "description": "expr-eval \u0438\u0437\u0440\u0430\u0437 \u043d\u0430\u043f\u0440. 'monthly_savings_amount > total_monthly_income'"
          },
          "message": {
            "type": "string",
            "description": "\u0421\u044a\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u043e \u043f\u0440\u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u0440\u0435\u0447\u0438\u0435"
          },
          "severity": {
            "type": "string",
            "enum": [
              "warning",
              "error"
            ],
            "default": "warning"
          }
        }
      }
    },
    "voice_step_id": {
      "type": "string",
      "description": "\u0420\u0435\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u044f \u043a\u044a\u043c VoiceRulebook step_id \u0437\u0430 this \u0432\u044a\u043f\u0440\u043e\u0441"
    },
    "is_reverification_key": {
      "type": "boolean",
      "default": false,
      "description": "true = \u043f\u043e\u043b\u0435\u0442\u043e \u0443\u0447\u0430\u0441\u0442\u0432\u0430 \u0432 reverification check \u043f\u0440\u0438 resume \u0441\u043b\u0435\u0434 14 \u0434\u043d\u0438"
    },
    "reverification_section": {
      "type": "string",
      "description": "\u0413\u0440\u0443\u043f\u0438\u0440\u0430 \u043f\u043e\u043b\u0435\u0442\u043e \u0432 \u0441\u0435\u043a\u0446\u0438\u044f \u0437\u0430 reverification \u043d\u0430\u043f\u0440. 'income', 'family'"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0422\u0430\u0433\u043e\u0432\u0435 \u0437\u0430 \u0444\u0438\u043b\u0442\u0440\u0438\u0440\u0430\u043d\u0435 \u043d\u0430\u043f\u0440. ['mandatory', 'compliance', 'scoring']"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "version": {
      "type": "string",
      "default": "1.0"
    }
  },
  "required": [
    "question_id",
    "section_id",
    "field_name",
    "label",
    "input_type"
  ]
}