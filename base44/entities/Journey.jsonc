{
  "name": "Journey",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Reference to Client entity"
    },
    "user_id": {
      "type": "string",
      "description": "Base44 authenticated user ID"
    },
    "device_id": {
      "type": "string",
      "description": "Browser device fingerprint stored in localStorage"
    },
    "language_code": {
      "type": "string",
      "enum": [
        "bg",
        "en"
      ],
      "default": "bg"
    },
    "journey_state": {
      "type": "string",
      "enum": [
        "discovery_not_started",
        "discovery_intro_in_progress",
        "discovery_collecting",
        "discovery_resumed_pending_reverification",
        "discovery_ready_for_review",
        "discovery_blocked",
        "analysis_approved",
        "plan_generating",
        "plan_ready",
        "plan_auto_sell_blocked",
        "presentation_intro_pending",
        "presentation_in_progress",
        "presentation_stopped_boundary",
        "application_collecting",
        "application_incomplete",
        "application_ready_for_signing",
        "signing_in_progress",
        "signing_failed",
        "payment_in_progress",
        "payment_failed",
        "provider_submission_in_progress",
        "completed",
        "expired",
        "graceful_stop"
      ],
      "default": "discovery_not_started"
    },
    "previous_state": {
      "type": "string",
      "description": "Last state before current, for rollback"
    },
    "state_changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "discovery_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "discovery_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "presentation_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "analysis_id": {
      "type": "string",
      "description": "Reference to FinancialAnalysisSubmission"
    },
    "plan_id": {
      "type": "string",
      "description": "Reference to FinancialPlan"
    },
    "rulebook_version": {
      "type": "string",
      "description": "Version of JSON Rulebook used for plan generation"
    },
    "ruleset_hash": {
      "type": "string",
      "description": "SHA256 hash of the rulebook for audit"
    },
    "auto_sell_eligible": {
      "type": "boolean",
      "default": false
    },
    "manual_review_required": {
      "type": "boolean",
      "default": false
    },
    "graceful_stop_reason": {
      "type": "string",
      "description": "Human-readable reason why automation stopped"
    },
    "follow_up_task_id": {
      "type": "string"
    },
    "retell_call_id": {
      "type": "string",
      "description": "Most recent Retell call ID for the presentation phase"
    },
    "presentation_section_index": {
      "type": "number",
      "default": 0,
      "description": "Which section of the plan presentation the user is on"
    },
    "is_resumed": {
      "type": "boolean",
      "default": false
    },
    "reverification_performed": {
      "type": "boolean",
      "default": false
    },
    "session_age_days": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": []
}