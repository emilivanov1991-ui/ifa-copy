{
  "name": "Provider Submission Failure \u2192 FollowUpTask",
  "description": "Creates FollowUpTask when ProviderSubmission fails after max attempts",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"permanent_failure\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ProviderSubmission"
    }
