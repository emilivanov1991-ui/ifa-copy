{
  "name": "Signing Reminder Email",
  "description": "Sends signing reminder email to client when SigningEvent status becomes 'sent'",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"sent\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "SigningEvent"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "signing_reminder_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendNotification",
            "args": {
              "type": "signing_reminder"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendNotification"
  }
}