{
  "name": "Auto Compliance Logger on Journey State Change",
  "description": "Automatically writes/updates ComplianceAuditRecord on every journey_state transition. Legal requirement.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"journey_state\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Journey"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_compliance_logger_on_journey_state_change",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoComplianceLogger",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoComplianceLogger"
  }
}