{
  "name": "ProductDocument",
  "type": "object",
  "properties": {
    "catalog_product_id": {
      "type": "string",
      "description": "Reference to ProductCatalog"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "terms_conditions",
        "factsheet",
        "kid",
        "brochure",
        "application_form",
        "tariff",
        "other"
      ],
      "description": "\u0422\u0438\u043f \u043d\u0430 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430"
    },
    "document_name": {
      "type": "string",
      "description": "\u0418\u043c\u0435 \u043d\u0430 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430"
    },
    "file_url": {
      "type": "string",
      "description": "URL \u043a\u044a\u043c \u0444\u0430\u0439\u043b\u0430"
    },
    "version": {
      "type": "string",
      "description": "\u0412\u0435\u0440\u0441\u0438\u044f \u043d\u0430 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430"
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "language": {
      "type": "string",
      "enum": [
        "bg",
        "en"
      ],
      "default": "bg"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "catalog_product_id",
    "document_type",
    "document_name"
  ]
}