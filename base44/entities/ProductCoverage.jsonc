{
  "name": "ProductCoverage",
  "type": "object",
  "properties": {
    "catalog_product_id": {
      "type": "string",
      "description": "Reference to ProductCatalog"
    },
    "coverage_name": {
      "type": "string",
      "description": "\u0418\u043c\u0435 \u043d\u0430 \u043f\u043e\u043a\u0440\u0438\u0442\u0438\u0435\u0442\u043e"
    },
    "coverage_code": {
      "type": "string",
      "description": "\u041a\u043e\u0434 \u0437\u0430 \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f"
    },
    "coverage_type": {
      "type": "string",
      "enum": [
        "death",
        "accident",
        "disability",
        "critical_illness",
        "hospital",
        "surgery",
        "dental",
        "outpatient",
        "other"
      ],
      "description": "\u0422\u0438\u043f \u043d\u0430 \u043f\u043e\u043a\u0440\u0438\u0442\u0438\u0435\u0442\u043e"
    },
    "is_included": {
      "type": "boolean",
      "default": false,
      "description": "\u0412\u043a\u043b\u044e\u0447\u0435\u043d\u043e \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0430\u0442\u0430 \u0446\u0435\u043d\u0430"
    },
    "is_optional": {
      "type": "boolean",
      "default": true,
      "description": "\u041c\u043e\u0436\u0435 \u0434\u0430 \u0441\u0435 \u0434\u043e\u0431\u0430\u0432\u0438 \u043e\u043f\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e"
    },
    "min_amount": {
      "type": "number"
    },
    "max_amount": {
      "type": "number"
    },
    "default_amount": {
      "type": "number"
    },
    "rate_per_1000": {
      "type": "number",
      "description": "\u0422\u0430\u0440\u0438\u0444\u0430 \u043d\u0430 1000 EUR"
    },
    "extra_premium_percent": {
      "type": "number",
      "description": "\u0414\u043e\u0431\u0430\u0432\u043a\u0430 \u043a\u044a\u043c \u043f\u0440\u0435\u043c\u0438\u044f\u0442\u0430 \u0432 %"
    },
    "flat_premium": {
      "type": "number",
      "description": "\u0424\u0438\u043a\u0441\u0438\u0440\u0430\u043d\u0430 \u0434\u043e\u0431\u0430\u0432\u043a\u0430"
    },
    "age_restrictions": {
      "type": "object",
      "properties": {
        "min_age": {
          "type": "number"
        },
        "max_age": {
          "type": "number"
        }
      }
    },
    "description": {
      "type": "string"
    },
    "display_order": {
      "type": "number",
      "default": 100
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "catalog_product_id",
    "coverage_name",
    "coverage_type"
  ]
}