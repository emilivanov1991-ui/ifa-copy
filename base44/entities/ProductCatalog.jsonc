{
  "name": "ProductCatalog",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "description": "\u0414\u043e\u0441\u0442\u0430\u0432\u0447\u0438\u043a \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430 (MetLife, UNIQA, Generali, Partners, \u041e\u0411\u0411 \u0438 \u0434\u0440.)"
    },
    "product_name": {
      "type": "string",
      "description": "\u0418\u043c\u0435 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "term_life",
        "ul_investment",
        "education_plan",
        "health_insurance",
        "critical_illness",
        "pension_plan",
        "personal_accident",
        "property_insurance",
        "partners_regular",
        "partners_single",
        "travel_insurance",
        "car_insurance",
        "home_insurance",
        "mortgage_loan",
        "consumer_loan",
        "business_insurance",
        "mountain_insurance",
        "professional_liability"
      ],
      "description": "\u0422\u0438\u043f \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430"
    },
    "category": {
      "type": "string",
      "enum": [
        "protection",
        "investment",
        "health",
        "pension",
        "property",
        "children",
        "travel",
        "auto",
        "home",
        "loans",
        "business"
      ],
      "description": "\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u0437\u0430 \u043a\u043b\u0430\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f"
    },
    "section": {
      "type": "string",
      "description": "\u0420\u0430\u0437\u0434\u0435\u043b/\u043f\u043e\u0434\u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f"
    },
    "min_age": {
      "type": "number",
      "default": 18
    },
    "max_age": {
      "type": "number",
      "default": 65
    },
    "min_term_years": {
      "type": "number",
      "default": 5
    },
    "max_term_years": {
      "type": "number",
      "default": 40
    },
    "min_monthly_premium": {
      "type": "number",
      "default": 30
    },
    "max_monthly_premium": {
      "type": "number"
    },
    "min_coverage": {
      "type": "number"
    },
    "max_coverage": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "enum": [
        "EUR",
        "BGN",
        "USD"
      ],
      "default": "EUR"
    },
    "entry_fee_percent": {
      "type": "number",
      "default": 0
    },
    "management_fee_percent": {
      "type": "number",
      "default": 0
    },
    "expected_return_conservative": {
      "type": "number"
    },
    "expected_return_balanced": {
      "type": "number"
    },
    "expected_return_dynamic": {
      "type": "number"
    },
    "smoker_multiplier": {
      "type": "number",
      "default": 1.5
    },
    "tax_deductible": {
      "type": "boolean",
      "default": false
    },
    "sellability_score": {
      "type": "number",
      "default": 5,
      "description": "\u041e\u0446\u0435\u043d\u043a\u0430 \u0437\u0430 \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u0435\u043c\u043e\u0441\u0442 1-10"
    },
    "commission_rate": {
      "type": "number",
      "description": "\u041a\u043e\u043c\u0438\u0441\u0438\u043e\u043d\u043d\u0430 \u0432 %"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u041e\u0441\u043d\u043e\u0432\u043d\u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438"
    },
    "target_profiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u041f\u043e\u0434\u0445\u043e\u0434\u044f\u0449 \u0437\u0430: families, singles, retirees, high_income, etc."
    },
    "upsell_products": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ID-\u0442\u0430 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438 \u0437\u0430 upsell"
    },
    "description": {
      "type": "string"
    },
    "sales_pitch": {
      "type": "string",
      "description": "\u041a\u0440\u0430\u0442\u043a\u043e \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0437\u0430 \u043f\u0440\u043e\u0434\u0430\u0436\u0431\u0430"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "number",
      "default": 100
    }
  },
  "required": [
    "provider",
    "product_name",
    "product_type",
    "category"
  ]
}