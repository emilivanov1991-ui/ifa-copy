{
  "name": "Client",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to User entity"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "portal_password": {
      "type": "string",
      "description": "Password for client portal access"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "inactive"
      ],
      "default": "pending"
    },
    "stage": {
      "type": "string",
      "enum": [
        "financial_planner",
        "analysis",
        "financial_plan_presented",
        "activated"
      ],
      "default": "financial_planner",
      "description": "\u0415\u0442\u0430\u043f \u0432 \u043f\u0440\u043e\u0446\u0435\u0441\u0430 \u043d\u0430 \u043e\u0431\u0441\u043b\u0443\u0436\u0432\u0430\u043d\u0435"
    },
    "family_type": {
      "type": "string",
      "enum": [
        "individual",
        "family"
      ],
      "description": "\u0422\u0438\u043f \u043a\u043b\u0438\u0435\u043d\u0442 \u043e\u0442 Financial Planner"
    },
    "partner_first_name": {
      "type": "string"
    },
    "partner_last_name": {
      "type": "string"
    },
    "partner_email": {
      "type": "string"
    },
    "children_count": {
      "type": "number",
      "default": 0
    },
    "children_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "children_ages": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "gdpr_consent_a": {
      "type": "boolean",
      "description": "\u0421\u044a\u0433\u043b\u0430\u0441\u0438\u0435 \u0437\u0430 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432 \u0430\u043d\u0430\u043b\u0438\u0437 \u0438 \u043f\u043e\u0441\u0440\u0435\u0434\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e"
    },
    "gdpr_consent_b": {
      "type": "boolean",
      "description": "\u0421\u044a\u0433\u043b\u0430\u0441\u0438\u0435 \u0437\u0430 \u043c\u0430\u0440\u043a\u0435\u0442\u0438\u043d\u0433 \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f"
    },
    "gdpr_consent_c": {
      "type": "boolean",
      "description": "\u0421\u044a\u0433\u043b\u0430\u0441\u0438\u0435 \u0437\u0430 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u044f\u043d\u0435 \u043d\u0430 \u0442\u0440\u0435\u0442\u0438 \u043b\u0438\u0446\u0430"
    },
    "gdpr_consent_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u043d\u0430 \u0434\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u0441\u044a\u0433\u043b\u0430\u0441\u0438\u044f\u0442\u0430"
    },
    "advisor_name": {
      "type": "string"
    },
    "advisor_email": {
      "type": "string"
    },
    "financial_plan_date": {
      "type": "string",
      "format": "date"
    },
    "total_portfolio_value": {
      "type": "number",
      "default": 0
    },
    "monthly_contribution": {
      "type": "number",
      "default": 0
    },
    "plan_slides_viewed": {
      "type": "number",
      "default": 0,
      "description": "\u0411\u0440\u043e\u0439 \u043f\u0440\u0435\u0433\u043b\u0435\u0434\u0430\u043d\u0438 \u0441\u043b\u0430\u0439\u0434\u043e\u0432\u0435 \u043e\u0442 \u043f\u0440\u0435\u0437\u0435\u043d\u0442\u0430\u0446\u0438\u044f\u0442\u0430 \u043d\u0430 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u0438\u044f \u043f\u043b\u0430\u043d"
    },
    "has_active_products": {
      "type": "boolean",
      "default": false,
      "description": "\u0418\u043c\u0430 \u043b\u0438 \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u043d\u0438 \u0438 \u043f\u043b\u0430\u0442\u0435\u043d\u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438"
    }
  },
  "required": [
    "email",
    "first_name",
    "last_name"
  ]
}