{
  "name": "Create FollowUp on Graceful Stop",
  "description": "Automatically creates a FollowUpTask when a journey stops gracefully",
  "trigger": {
    "condition": "${ (.trigger.data.journey_state == \"graceful_stop\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Journey"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "create_followup_on_graceful_stop",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "createFollowUpTask",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "createFollowUpTask"
  }
}