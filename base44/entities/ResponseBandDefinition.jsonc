{
  "name": "ResponseBandDefinition",
  "type": "object",
  "properties": {
    "band_id": {
      "type": "string",
      "description": "\u0423\u043d\u0438\u043a\u0430\u043b\u0435\u043d ID \u043d\u0430\u043f\u0440. 'reserve_critical', 'income_high', 'mortgage_overloaded'"
    },
    "category": {
      "type": "string",
      "description": "\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u043d\u0430\u043f\u0440. 'reserve', 'income', 'protection', 'housing', 'pension'",
      "enum": [
        "reserve",
        "income",
        "protection",
        "housing",
        "pension",
        "children",
        "investment",
        "debt",
        "general"
      ]
    },
    "language_code": {
      "type": "string",
      "enum": [
        "bg",
        "en"
      ],
      "default": "bg"
    },
    "band_label": {
      "type": "string",
      "description": "\u0427\u0435\u0442\u0438\u043c\u043e \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043d\u0430\u043f\u0440. '\u041a\u0440\u0438\u0442\u0438\u0447\u043d\u043e \u043d\u0438\u0441\u044a\u043a \u0440\u0435\u0437\u0435\u0440\u0432'"
    },
    "expression": {
      "type": "string",
      "description": "expr-eval \u0438\u0437\u0440\u0430\u0437 \u0437\u0430 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u043d\u0435 \u043d\u0430 \u0431\u0430\u043d\u0434\u0430 \u043d\u0430\u043f\u0440. 'desired_reserve_months < 1'"
    },
    "priority": {
      "type": "number",
      "default": 100,
      "description": "\u041f\u043e-\u043d\u0438\u0441\u044a\u043a = \u043f\u043e-\u0432\u0438\u0441\u043e\u043a \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442 \u043f\u0440\u0438 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0441\u044a\u0432\u043f\u0430\u0434\u0430\u0449\u0438 \u0431\u0430\u043d\u0434\u043e\u0432\u0435"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "caution",
        "warning",
        "critical"
      ],
      "default": "info",
      "description": "\u041d\u0438\u0432\u043e \u043d\u0430 \u0432\u0430\u0436\u043d\u043e\u0441\u0442 \u2014 \u0432\u043b\u0438\u044f\u0435 \u043d\u0430 \u0446\u0432\u0435\u0442\u0430 \u0438 \u0438\u043a\u043e\u043d\u0430\u0442\u0430 \u0432 UI"
    },
    "voice_step_id": {
      "type": "string",
      "description": "\u0420\u0435\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u044f \u043a\u044a\u043c VoiceRulebook \u0437\u0430 \u0430\u0443\u0434\u0438\u043e \u0440\u0435\u0430\u043a\u0446\u0438\u044f \u043f\u0440\u0438 \u0432\u043b\u0438\u0437\u0430\u043d\u0435 \u0432 \u0431\u0430\u043d\u0434\u0430"
    },
    "avatar_state": {
      "type": "string",
      "enum": [
        "talking",
        "listening",
        "thinking",
        "celebrating",
        "concerned",
        "idle"
      ],
      "default": "talking"
    },
    "ui_message": {
      "type": "string",
      "description": "\u0422\u0435\u043a\u0441\u0442\u043e\u0432\u043e \u0441\u044a\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u043e \u0432 UI \u043f\u0440\u0438 \u0430\u043a\u0442\u0438\u0432\u0435\u043d \u0431\u0430\u043d\u0434"
    },
    "recommendation_text": {
      "type": "string",
      "description": "\u041f\u0440\u0435\u043f\u043e\u0440\u044a\u043a\u0430 \u043f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0430 \u043d\u0430 \u043a\u043e\u043d\u0441\u0443\u043b\u0442\u0430\u043d\u0442\u0430 \u0438\u043b\u0438 \u043a\u043b\u0438\u0435\u043d\u0442\u0430"
    },
    "affects_plan_generation": {
      "type": "boolean",
      "default": false,
      "description": "true = \u0431\u0430\u043d\u0434\u0430 \u0432\u043b\u0438\u044f\u0435 \u043d\u0430 \u043b\u043e\u0433\u0438\u043a\u0430\u0442\u0430 \u043f\u0440\u0438 \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u0438\u044f \u043f\u043b\u0430\u043d"
    },
    "plan_flag": {
      "type": "string",
      "description": "\u0424\u043b\u0430\u0433 \u043f\u0440\u0435\u0434\u0430\u0432\u0430\u043d \u043a\u044a\u043c \u043f\u043b\u0430\u043d \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440\u0430 \u043d\u0430\u043f\u0440. 'low_reserve_priority', 'auto_sell_blocked'"
    },
    "triggers_graceful_stop": {
      "type": "boolean",
      "default": false,
      "description": "true = \u0431\u0430\u043d\u0434\u0430 \u0441\u043f\u0438\u0440\u0430 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f\u0442\u0430 \u0438 \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u0430 FollowUpTask"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "version": {
      "type": "string",
      "default": "1.0"
    }
  },
  "required": [
    "band_id",
    "category",
    "band_label",
    "expression"
  ]
}