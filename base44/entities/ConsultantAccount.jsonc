{
  "name": "ConsultantAccount",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "\u041f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0441\u043a\u043e \u0438\u043c\u0435"
    },
    "password_hash": {
      "type": "string",
      "description": "SHA-256 \u0445\u0435\u0448 \u043d\u0430 \u043f\u0430\u0440\u043e\u043b\u0430\u0442\u0430"
    },
    "full_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "consultant",
        "senior",
        "admin"
      ],
      "default": "consultant"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "username",
    "password_hash",
    "full_name"
  ]
}