{
  "name": "Provider Submission Confirmed Notification",
  "description": "Sends confirmation email when provider submission succeeds",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"success\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ProviderSubmission"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "provider_submission_confirmed_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendNotification",
            "args": {
              "type": "provider_submission_confirmed"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendNotification"
  }
}