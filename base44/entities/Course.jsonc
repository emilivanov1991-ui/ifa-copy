{
  "name": "Course",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "level": {
      "type": "number",
      "enum": [
        1,
        2,
        3
      ],
      "description": "1=Junior, 2=Senior, 3=Expert"
    },
    "category": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 100
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "passing_score": {
      "type": "number",
      "default": 80,
      "description": "\u041c\u0438\u043d. % \u0437\u0430 \u0438\u0437\u043f\u0438\u0442"
    }
  },
  "required": [
    "title",
    "level"
  ]
}